<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('../partials/daisyui.ejs') %>
</head>

<body class="min-h-screen w-full">
  <%- include('../partials/navbar.ejs') %>
    <% if (success) { %>
      <% if (!user.isAdmin) { %>
        <button
          class="relative top-6 lg:left-[95%] w-10 h-10 left-[87%] cursor-pointer mask mask-heart <%= user.wishlist.includes(product._id) ? 'bg-red-500' : 'bg-gray-200' %>"
          id="wishlist">
        </button>
        <% } %>
          <div class="shadow-sm hover:shadow-md transition p-4 rounded flex justify-between gap-6 min-h-2/3">
            <div class="flex max-h-2/3 justify-between items-center w-full flex-wrap px-8 sm:px-10 md:px-16 lg:px-20">
              <div class="w-full p-4 sm:w-full lg:w-1/2 justify-center flex flex-col gap-4">
                <% if (user.isAdmin) { %>
                  <h2 class="font-semibold text-lg"> #<%= product._id %>
                  </h2>
                  <% } %>

                    <div class="font-bold text-4xl flex items-center h-fit">
                      <%= product.name %>
                    </div>
                    <p class="text-lg">
                      <%= product.description %> Lorem ipsum dolor sit amet consectetur
                        adipisicing elit. Repellat, at odit, fuga error laborum libero dolor
                        id quo placeat minima temporibus in maiores!
                    </p>
                    <p class="text-xl font-semibold my-2">
                      <%= product.price %>/- RS
                    </p>
                    <div class="flex flex-col">
                      <div class="flex items-center flex-row gap-2">
                        Overall Rating: <% if (product.rating===0) { %>
                          Not Rated Yet
                          <% } else { %>
                            <% for( let i=0; i < product.rating; i++ ) { %>
                              <div class="mask mask-star-2 bg-orange-400 h-6 w-6"></div>
                              <% } %>
                                <% } %>
                      </div>
                      <% if (user && user.purchaseHistory.some(item=> (item.product.toString()) ===
                        product._id.toString()
                        &&
                        !item.rated))
                        { %>
                        <span class="flex items-center gap-2">
                          Your Rating: <span class="font-bold mt-2 flex items-center gap-2">
                            <div class="rating">
                              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400"
                                aria-label="1 star" />
                              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400"
                                aria-label="2 star" checked="checked" />
                              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400"
                                aria-label="3 star" />
                              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400"
                                aria-label="4 star" />
                              <input type="radio" name="rating-2" class="mask mask-star-2 bg-orange-400"
                                aria-label="5 star" />
                            </div>
                            <button id="ratingBtn">Done</button>
                          </span>
                        </span>
                        <% } %>
                    </div>
                    <p>
                      Category:
                      <span class="badge badge-primary badge-outline">
                        <%= product.category %>
                      </span>
                    </p>

                    <p>
                      Stock: <% if (product.stock> 5) { %>
                        <span class="text-green-600 font-bold">Available</span>
                        <% } else if (product.stock> 0 && product.stock <= 5) { %>

                            <span class="text-yellow-600 font-bold">Limited stock</span>
                            <% } else { %>
                              <span class="text-red-600 font-bold">Out of stock</span>
                              <% } %>
                    </p>

                    <div>

                      <div class="<%= product.stock <= 0 ? " hidden" : "" %>">
                        <% if (!user.isAdmin) { %>
                          <div class="flex items-center flex-row justify-between mt-8">
                            <div class="flex items-center w-fit gap-2">
                              <div dir="ltr">
                                <button class="w-2 h-8 rounded-s-lg text-center font-bold btn btn-outline btn-accent"
                                  onclick="decreaseQuantity('<%= product._id %>')">
                                  -
                                </button>
                              </div>
                              <p class="quantity-text w-2 text-center" id="<%= product._id %>">
                                1
                              </p>
                              <div dir="rtl">
                                <button class="w-2 h-8 rounded-s-lg text-center font-bold btn btn-outline btn-accent"
                                  onclick="increaseQuantity('<%= product._id %>')">
                                  +
                                </button>
                              </div>
                            </div>
                          </div>

                          <div class="flex gap-4 items-center mt-4">
                            <button class="btn btn-outline btn-primary"
                              onclick="addToCart(<%= JSON.stringify(product) %>)">
                              Add
                            </button>
                            <button class="btn btn-outline btn-error"
                              onclick="removeFromCart(<%= JSON.stringify(product._id) %>)">
                              Remove
                            </button>
                          </div>
                          <% } %>
                      </div>
                    </div>
              </div>

              <figure class="w-fit border rounded-lg p-4 shadow-lg">
                <img src="<%= product.imageURL %>" alt="<%= product.name %>"
                  class="h-64 md:h-80 lg:h-96 object-cover w-full rounded" />
              </figure>
            </div>
          </div>
          <% } else { %>
            <p>
              <%= message %>
            </p>
            <% } %>
              <script src="/javascript/common.js"></script>
              <script src="/javascript/cartLogic.js"></script>
              <script>
                const ratingBtn = document.getElementById("ratingBtn")
                if (ratingBtn) {
                  ratingBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    ratingBtn.disabled = true;
                    let result = fetch("/user/rating", {
                      method: "POST",
                      headers: {
                        "Content-Type": "application/json"
                      },
                      body: JSON.stringify({
                        productId: "<%= product._id %>",
                        // Get selected rating value
                        rating: Number(document.querySelector('input[name="rating-2"]:checked').getAttribute("aria-label").split(" ")[0])
                      })
                    }).then(res => res.json())
                      .then(data => {
                        if (data.success) {
                          window.location.reload();
                        } else {
                          toast(data.message, "error");
                          ratingBtn.disabled = false;
                        }
                      })
                      .catch(err => {
                        console.error("Error:", err);
                        toast("Error submitting rating. Please try again.", "error");
                      });
                  });
                }

                const wishlistBtn = document.getElementById("wishlist");
                wishlistBtn.addEventListener("click", (e) => {
                  e.stopPropagation();
                  wishlistBtn.disabled = true;
                  let isInWishlist = <%= user.wishlist.includes(product._id) ? 'true' : 'false' %>;
                  let url = isInWishlist ? `/user/removeFromWishlist/<%= product._id %>` : '/user/addToWishlist';
                  let method = 'POST';

                  let result = fetch(url, {
                    method: method,
                    headers: {
                      "Content-Type": "application/json"
                    },
                    body: isInWishlist ? null : JSON.stringify({ productId: "<%= product._id %>" })
                  }).then(res => res.json())
                    .then(data => {
                      if (data.success) {
                        window.location.reload();
                      } else {
                        toast(data.message, "error");
                        wishlistBtn.disabled = false;
                      }
                    })
                    .catch(err => {
                      console.error("Error:", err);
                      toast("Error updating wishlist. Please try again.", "error");
                    });
                })
              </script>
</body>

</html>