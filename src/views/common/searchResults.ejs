<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search</title>
  <%- include('../partials/daisyui.ejs') %>
</head>

<body>
  <%- include('../partials/navbar.ejs') %>
    <main class="p-6 min-h-[70vh] flex flex-col gap-6">
      <div>
        <h2 class="text-2xl font-semibold mb-6">Search Results</h2>
      </div>
      <div class="flex flex-wrap items-center justify-center w-full h-full p-4 gap-6">
        <% products.forEach(product=> { %>
          <div class="border p-2 rounded-lg shadow-md flex gap-4">
            <div class="mr-4">
              <img src="<%= product.imageURL || 'https://shorturl.at/RnRet' %>" alt="<%= product.name %>"
                class="w-48 h-48 object-cover rounded-md" />
            </div>
            <div class="mt-1 flex flex-col gap-4">
              <div>
                <h3 class="text-xl font-medium line-clamp-1 w-48">
                  <%= product.name %>
                </h3>
                <p class="text-gray-600 text-ellipsis w-32 overflow-hidden whitespace-nowrap">
                  <%= product.description %>
                </p>
                <p class="text-green-600 font-semibold">$<%= product.price %>
                </p>
              </div>
              <p class="text-sm sm:text-xs md:text-sm lg:text-sm w-fit">
                Category: <%= product.category %>
              </p>
              <button class="btn btn-primary btn-outline mt-2" onclick="location.href='/products/<%= product._id %>'">
                View Details
              </button>
            </div>
          </div>
          <% }) %>
      </div>
    </main>
    <footer class="mt-8">
      <hr class="my-6" />
      <p class="text-center text-gray-500">
        &copy; <%= new Date().getFullYear() %> ShahmeerJS . All rights reserved.
      </p>
    </footer>
    <script src="/javascript/common.js"></script>
    <%- include('../partials/errorHandle.ejs') %>
</body>

</html>