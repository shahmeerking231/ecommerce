<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Completed</title>
    <%- include('../partials/daisyui.ejs') %>
</head>

<body>
    <% if (order) { %>
        <main class="h-screen w-full">
            <section class="flex flex-col justify-center items-center h-full">
                <div class="flex gap-2 mb-3">
                    <img src="/images/failure.png" alt="Failure" class="w-10 h-10">
                    <h1 class="text-4xl font-bold mb-6">Payment Failed!</h1>
                </div>
                <p class="text-lg mb-4">Your payment could not be processed. Please try again.</p>
                <p class="text-lg">Order ID: <span class="font-semibold">
                        <%= order._id %>
                    </span></p>
                <button onclick="window.location.href='/'" class="btn btn-primary mt-4">Continue Shopping</button>
            </section>
        </main>
        <% } else { %>
            <p class="text-center text-2xl font-bold mt-20">Order details not found.</p>
            <% } %>

                <%- include('../partials/errorHandle') %>
</body>

</html>