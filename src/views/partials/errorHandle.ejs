<div class="toast toast-top toast-end">
  <% if (typeof error !=='undefined' && error || typeof message !=='undefined' && message) { %>
    <div class="alert <% if (typeof error !=='undefined' && error) { %>alert-error<% } else { %>alert-info<% } %>">
      <div>
        <span>
          <%= typeof error !== 'undefined' && error ? error : message %>
        </span>
      </div>
    </div>
    <% } %>
</div>
<script>
  const toasts = document.querySelectorAll(".alert");
  if (toasts.length > 0) {
    toasts.forEach((toast) => {
      setTimeout(() => {
        toast.remove();
      }, 3000);
    });
  }
</script>