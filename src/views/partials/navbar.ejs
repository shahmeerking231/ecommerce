<header>
  <div class="p-6 flex justify-between items-center bg-blue-500">
    <h1 class="lg:text-3xl md:text-2xl sm:text-2xl text-xl font-bold text-white">
      E-Commerce Platform
    </h1>
    <div class="flex justify-center items-center gap-4">
      <% if (locals.user.isAdmin) { %>
        <button class="btn btn-neutral btn-soft" onclick="location.href='/addProduct'">
          Add Product
        </button>
        <% } else { %>
          <a class="font-bold text-[3vh]" href="/cart">🛒</a>
          <% } %>
            <a class="btn btn-error btn-soft" href="/api/auth/logout">Logout</a>
    </div>
  </div>
  <div class="block sm:block lg:hidden md:hidden border-b-1 w-full h-14 flex justify-end items-center p-4"
    id="hamburger">
    <img src="/images/hamburger.png" alt="Hamburger" height="50px" width="50px">
  </div>
  <nav
    class="h-3/4 sm:h-3/4 w-3/5 sm:w-3/5 md:w-full lg:w-full md:h-14 lg:h-14 flex items-center justify-between hidden gap-6 flex-col sm:hidden lg:flex md:flex sm:flex-col md:flex-row lg:flex-row lg:border-b-1 px-8 m-4 md:m-0 lg:m-0"
    id="nav">
    <div class="flex gap-6 flex-col sm:flex-col md:flex-row lg:flex-row">
      <a class="border-b border-transparent hover:border-b hover:border-black transition-all duration-200"
        href="/">Home</a>
      <a class="border-b border-transparent hover:border-b hover:border-black transition-all duration-200"
        href="<%= locals.user.isAdmin ? " /orders" : "/user/orders" %>"
        >Orders</a>
      <% if (!locals.user.isAdmin) { %>
        <a class="border-b border-transparent hover:border-b hover:border-black transition-all duration-200"
          href="/user/wishlist">Wishlist</a>
        <% } %>
          <a class="border-b border-transparent hover:border-b hover:border-black transition-all duration-200"
            href="/user/profile">Profile</a>
    </div>
    <div>
      <form action="/products/api/search" method="GET" class="flex">
        <input type="text" name="key" placeholder="Search products..."
          class="input input-bordered w-52 sm:w-52 md:w-64 lg:w-64" />
        <button type="submit" class="btn btn-primary btn-outline ml-2">
          Search
        </button>
      </form>
    </div>
  </nav>
</header>
<script>
  const hamburger = document.getElementById("hamburger");
  const nav = document.getElementById("nav");
  hamburger.addEventListener("click", () => {
    nav.classList.toggle("hidden");
    nav.classList.toggle("sm:hidden");
    nav.classList.toggle("items-center");
  });

  // Close the nav when a link is clicked (for better UX on mobile)
  const navLinks = nav.querySelectorAll("a");
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (!nav.classList.contains("hidden")) {
        nav.classList.add("hidden");
      }
    });
  });
</script>